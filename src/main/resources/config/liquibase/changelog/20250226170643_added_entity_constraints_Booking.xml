<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">
    <!--
        Added the constraints for entity Booking.
    -->
    <changeSet id="20250226170643-2" author="jhipster">

        <addForeignKeyConstraint baseColumnNames="time_slots_id"
                                 baseTableName="booking"
                                 constraintName="fk_booking__time_slots_id"
                                 referencedColumnNames="id"
                                 referencedTableName="time_slot"
                                 />

        <addForeignKeyConstraint baseColumnNames="booked_activity_id"
                                 baseTableName="booking"
                                 constraintName="fk_booking__booked_activity_id"
                                 referencedColumnNames="id"
                                 referencedTableName="activity"
                                 />

        <addForeignKeyConstraint baseColumnNames="booking_location_id"
                                 baseTableName="booking"
                                 constraintName="fk_booking__booking_location_id"
                                 referencedColumnNames="id"
                                 referencedTableName="location"
                                 />

        <addForeignKeyConstraint baseColumnNames="creator_id"
                                 baseTableName="booking"
                                 constraintName="fk_booking__creator_id"
                                 referencedColumnNames="id"
                                 referencedTableName="profile"
                                 />

        <addForeignKeyConstraint baseColumnNames="activity_id"
                                 baseTableName="booking"
                                 constraintName="fk_booking__activity_id"
                                 referencedColumnNames="id"
                                 referencedTableName="activity"
                                 />

        <addForeignKeyConstraint baseColumnNames="time_slot_id"
                                 baseTableName="booking"
                                 constraintName="fk_booking__time_slot_id"
                                 referencedColumnNames="id"
                                 referencedTableName="time_slot"
                                 />
    </changeSet>
</databaseChangeLog>
