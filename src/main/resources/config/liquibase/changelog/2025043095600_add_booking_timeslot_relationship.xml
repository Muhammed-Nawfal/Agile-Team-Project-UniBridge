<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="2025043095600-1" author="nicole">
        <!-- Add booking_id column to time_slot table -->
        <addColumn tableName="time_slot">
            <column name="booking_id" type="bigint"/>
        </addColumn>
        
        <!-- Add foreign key constraint -->
        <addForeignKeyConstraint baseColumnNames="booking_id"
                                 baseTableName="time_slot"
                                 constraintName="fk_time_slot_booking_id"
                                 referencedColumnNames="id"
                                 referencedTableName="booking"/>
    </changeSet>
</databaseChangeLog>
