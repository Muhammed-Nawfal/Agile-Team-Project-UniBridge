<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">
    <!--
        Added the constraints for entity Chat.
    -->
    <changeSet id="20250226170648-2" author="jhipster">

        <addForeignKeyConstraint baseColumnNames="thread_id"
                                 baseTableName="chat"
                                 constraintName="fk_chat__thread_id"
                                 referencedColumnNames="id"
                                 referencedTableName="message_thread"
                                 />

        <addForeignKeyConstraint baseColumnNames="sender_id"
                                 baseTableName="chat"
                                 constraintName="fk_chat__sender_id"
                                 referencedColumnNames="id"
                                 referencedTableName="profile"
                                 />

        <addForeignKeyConstraint baseColumnNames="receiver_id"
                                 baseTableName="chat"
                                 constraintName="fk_chat__receiver_id"
                                 referencedColumnNames="id"
                                 referencedTableName="profile"
                                 />

        <addForeignKeyConstraint baseColumnNames="message_thread_id"
                                 baseTableName="chat"
                                 constraintName="fk_chat__message_thread_id"
                                 referencedColumnNames="id"
                                 referencedTableName="message_thread"
                                 />
    </changeSet>
</databaseChangeLog>
