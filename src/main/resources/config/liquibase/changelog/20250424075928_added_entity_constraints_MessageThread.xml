<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">
    <!--
        Added the constraints for entity MessageThread.
    -->
    <changeSet id="20250424075928-2" author="jhipster">

        <addForeignKeyConstraint baseColumnNames="friend_chat_id"
                                 baseTableName="message_thread"
                                 constraintName="fk_message_thread__friend_chat_id"
                                 referencedColumnNames="id"
                                 referencedTableName="friends_list"
                                 />

        <addForeignKeyConstraint baseColumnNames="match_chat_id"
                                 baseTableName="message_thread"
                                 constraintName="fk_message_thread__match_chat_id"
                                 referencedColumnNames="id"
                                 referencedTableName="activity_match"
                                 />

        <addForeignKeyConstraint baseColumnNames="message_thread_id"
                                 baseTableName="rel_message_thread__participants"
                                 constraintName="fk_rel_message_thread__participants__message_thread_id"
                                 referencedColumnNames="id"
                                 referencedTableName="message_thread"
                                 />

        <addForeignKeyConstraint baseColumnNames="participants_id"
                                 baseTableName="rel_message_thread__participants"
                                 constraintName="fk_rel_message_thread__participants__participants_id"
                                 referencedColumnNames="id"
                                 referencedTableName="profile"
                                 />
    </changeSet>
</databaseChangeLog>
