entity ActivityMatch {
  activityType ActivityType required,
  status Decision required,
  matchDate LocalDate required, // Just the date component
  matchTime Instant required, // Just the time component
  location String maxlength(100),
  notes TextBlob,
  createdAt Instant required,
  responseAt Instant required,
}

enum Decision {
  ACCEPT,
  DECLINED,
  PENDING
}

relationship ManyToOne {
  ActivityMatch{matchRequestor} to Profile // Track who created the activity
}

relationship ManyToOne {
  ActivityMatch{userDetails} to Profile
}

relationship ManyToOne {
  ActivityMatch{matchedActivity} to Activity
}

relationship OneToOne {
  ActivityMatch{ratings} to Ranking
}

// Activity entity with all fields
entity Activity {
  activityName String required minlength(1) maxlength(120),
  activityType ActivityType required,
  activityDate Instant required,
  numberOfParticipants Integer required, // There can be logic that increments the number of participants of an event
  maxNumberOfParticipants Integer required min(2),
  location String required maxlength(95),
  description TextBlob,
  createdOn Instant required,
  updatedOn Instant required,
  status Status required,
  coverImage ImageBlob,
  isPaid Boolean required,
  activityCost BigDecimal required min(0)
}

// Entity to track activity participation
entity ActivityParticipant {
  joinedDate Instant required,
  status ParticipationStatus required
}

// Activity relationships
relationship ManyToOne {
  Activity{creator} to Profile // Track who created the activity
}

relationship OneToMany {
  Activity{bookings} to Booking // One activity can have several bookings
}

// ActivityParticipant relationships for tracking users joining activities
relationship ManyToOne {
  ActivityParticipant{participant} to Profile, // The user who joined
  ActivityParticipant{activity} to Activity // The activity they joined
}

// Activity-related enums
enum ActivityType {
  SOCIAL,
  ACADEMIC,
  SPORTS,
  GYM,
  OTHER
}

enum Status {
  ANNOUNCED,
  CURRENTLY_HAPPENING,
  FINISHED,
  CANCELED
}

enum ParticipationStatus {
  PENDING,
  CONFIRMED,
  CANCELED
}

entity FriendsList {
  requestTime Instant required,
  requestStatus Decision required,
  friendSince Instant required,
  nickname String
}

relationship ManyToOne {
  FriendsList{requestedByProfile} to Profile,
  FriendsList{requestedToProfile} to Profile
}

entity Chat {
  message TextBlob,
  timestamp Instant required,
  status MessageStatus required,
  type MessageType required,
  media ImageBlob,
  isDeleted Boolean required,
  createdOn Instant required,
  updatedOn Instant
}

entity MessageThread {
  isGroup Boolean required,
  name String maxlength(100), // Only used for group chats
  createdOn Instant required,
  updatedOn Instant
}

enum MessageStatus {
  SENT,
  DELIVERED,
  READ
}

enum MessageType {
  TEXT,
  IMAGE,
  VIDEO,
  FILE
}

relationship ManyToOne {
  Chat{thread} to MessageThread,
  Chat{sender} to Profile,
  Chat{receiver} to Profile
}

relationship ManyToMany {
  MessageThread{participants} to Profile
}

relationship OneToMany {
  MessageThread{messages} to Chat
}

relationship OneToOne {
  MessageThread{friendChat} to FriendsList
}

relationship OneToOne {
  MessageThread{matchChat} to ActivityMatch
}

entity Ranking {
  reviewNumber Integer required,
  activityNumber Integer required,
  starAverage BigDecimal required min(0) max(5),
  reliable Boolean required
}
entity Review {
  datePublished Instant required,
  star BigDecimal required min(0) max(5),
  text String minlength(0) maxlength(300)
}
relationship OneToOne {
  Ranking{rankGiven} to Profile
}
relationship ManyToOne {
  Review{aboutUser} to Profile,
  Review{fromUser} to Profile
}

entity Challenge {
  title String required minlength(3) maxlength(100),
  description TextBlob required,
  category Category required,
  date LocalDate required,
  points Integer required min(1) max(100),
  badge ImageBlob required minbytes(10) maxbytes(1000000),
  completed Boolean required
}

enum Category {
  STUDY,
  SPORTS,
  COMMUNITY,
  PERSONAL_GROWTH,
  SOCIAL
}

relationship ManyToOne {
  Challenge{assignedTo} to Profile,
  Challenge{createdBy} to Profile
}

relationship OneToMany{
  Challenge{activities} to Activity
}

enum EventType {
  STUDY_SPACES,
  EVENT_ROOMS,
  FOOTBALL_PITCH,
  TENNIS_COURT,
  BASKETBALL_COURT,
  DOJO,
  SWIMMING_POOL,
  SQUASH_COURT // ADD MORE IF NEEDED. IM NOT SURE IF THERES MORE.
}

enum BookingStatus {
  CONFIRMED,
  CANCELLED
}

enum AvailabilityStatus {
  AVAILABLE,
  FULL,
  OCCUPIED,
  BLOCKED,
  MAINTENANCE
}

entity Event {
  name String required,
  value String required,
  activityType ActivityType required,
  minSize Integer required,
  maxSize Integer required,
  startTime Integer,
  endTime Integer,
  capacity Integer
}

entity TimeSlot {
  date LocalDate required,
  startHour Integer required,
  endHour Integer required,
  capacity Integer required,
  remainingCapacity Integer,
  status AvailabilityStatus required
}


entity Booking {
  activityType ActivityType required,
  eventType EventType required,
  bookingDate LocalDate required,
  partySize Integer required,
  bookingStatus BookingStatus required,
  createdAt Instant,
  assignedAt Instant
}

entity Location {
  name String required,
  status AvailabilityStatus required,
  capacity Integer required,
  remainingCapacity Integer,
  isCapacityBased Boolean required
}

relationship ManyToOne {
  TimeSlot{event} to Event
  Booking{timeSlots} to TimeSlot
  Booking{bookedActivity} to Activity
  Booking{bookingLocation} to Location
  Booking{creator} to Profile
}

relationship OneToMany {
  TimeSlot{bookingsList} to Booking
}
