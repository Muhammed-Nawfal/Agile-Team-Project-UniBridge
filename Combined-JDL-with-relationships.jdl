entity Profile {
    Bio TextBlob, //max bio length set to 50 characters
    profilePicture ImageBlob,
    course Course required,
    courseYear Long required min(1) max(6), //Course year range 1-6
    university String required minlength(1) maxlength(50),
    gymSkill Skill,
    gymLocation GymLocation,
    gymTime PreferredTime,
    studyTime PreferredTime,
    sports Sports,
    sportsSkill Skill,
    sportsTime PreferredTime,
    preferredSociety String,
    preferredEvents String,
    eventsTime PreferredTime,
    preferredActivities ActivityType,
}


relationship OneToOne {
	Profile{user} to User with builtInEntity
}

enum Course {
	COMPUTER_SCIENCE,
	ECONOMICS,
    PSYCHOLOGY,
    MATHS,
    ENGLISH,
    ENGINEERING
}
enum Skill {
    NOVICE,
    INTERMEDIATE,
    CONFIDENT,
    PROFESSIONAL
}
enum PreferredTime {
    EARLY MORNING,
    MORNING,
    AFTERNOON,
    EVENING,
    NIGHT,
    LATE NIGHT
}
enum GymLocation {
    THE_GYM_SELLY_OAK,
    TIVERTON,
    PUREGYM_FIVE_WAYS
}
enum Sports{
	FOOTBALL,
    CRICKET,
    BADMINTON,
    TENNIS,
    NETBALL
}


entity Activity {
    activityName String required minlength(1) maxlength(120),
    activityType ActivityType required,
    activityDate Instant required,
    numberOfParticipants Integer required, //There can be some logic that incremenets the number of participants of an event
    maxNumberOfParticipants Integer required min(2),
    location String required maxlength(95),
    description TextBlob,
    createdOn Instant required,
    updatedOn Instant required,
    status Status required,
    coverImage ImageBlob,
    //New fields added
    paid IsPaid required,
    costOfactivity BigDecimal required //We can add a conditional statement that if the paid field evaluates to notPaid then the cost of the activity is 0
}
enum IsPaid {
	PAID,
    NOTPAID
}
enum Status {
    ANNOUNCED,
    CURRENTLY_HAPPENING,
    FINISHED,
    CANCELED
}

enum ActivityType {
	SOCIAL,
    ACADEMIC,
    SPORTS,
    GYM,
    OTHER
}

relationship ManyToOne {
  Activity{UserName} to Profile
}

relationship ManyToOne {
	Activity{requesteduser} to User with builtInEntity // Many activities can be linked to multiple Profiles
}

relationship OneToMany {
	Activity{booking} to Booking //One activity can have several bookings
}


entity ActivityMatch {
    activityType ActivityType required,
    status Decision required,
}

enum Decision {
  ACCEPT,
  DECLINED,
  PENDING
}

relationship ManyToOne {
	ActivityMatch{UserName} to Profile
}

relationship ManyToOne {
    ActivityMatch{requestUser} to User with builtInEntity
}
relationship ManyToOne {
    ActivityMatch{matchedUser} to User with builtInEntity
}

relationship ManyToOne {
	ActivityMatch{matchedActivity} to Activity
}

entity Booking {
    bookingName String required,
    bookingStatus Status required,
    bookingTime Instant required,
    bookingDate Instant required,
    phoneNum String required minlength(11) maxlength(11),
    bookingType BookingType required,
    numOfParticipants Integer required min(1),
    bookStartTime Instant required,
    bookEndTime Instant required
}
enum BookingType{
	FOOTBALL_PITCH,
	TENNIS_COURT,
	BASKETBALL_COURT,
	STUDY_SPACES,
	EVENT_ROOMS,
	DOJO,
	SWIMMING_POOL,
	SQUASH_COURT
}

relationship OneToOne {
	Booking{bookingDoneBy} to Profile
}

relationship ManyToOne {
	Booking{requestedUser} to User with builtInEntity
}

relationship ManyToOne {
	Booking{bookedActivity} to Activity
}

entity FriendsList {
    friendRequest Decision required,
    friendSince Instant required
}

relationship ManyToOne {
	FriendsList{friends} to Profile
}


relationship ManyToOne {
    FriendsList{user} to User with builtInEntity,
    FriendsList{friend} to User with builtInEntity
}


entity Ranking {
  reviewNumber Integer required,
  activityNumber Integer required,
  starAverage BigDecimal required min(0) max(5),
  reliable Reliability required
}

enum Reliability {
  UNRELIABLE,
  RELIABLE
}

entity Review {
  datePublished Instant required,
  star BigDecimal required min(0) max(5),
  text String minlength(0) maxlength(300)
}
relationship OneToOne {
	Ranking{rankGiven} to Profile
}

relationship ManyToOne {
	Review{reviewsGiven} to Profile
}

relationship ManyToOne {
  Review{aboutUser} to User with builtInEntity,
  Review{fromUser} to User with builtInEntity
}
relationship OneToOne {
  Ranking{user} to User with builtInEntity
}
entity Chat {
    message TextBlob required,
    timestamp Instant required,
    type ActionType required
}

enum ActionType{
    UNMATCH,
    REPORT
}
relationship ManyToOne {
	Chat{chats} to Profile
}

relationship OneToOne {
	Chat{friendChat} to FriendsList
}

relationship ManyToOne {
    Chat{sender} to User with builtInEntity,
    Chat{receiver} to User with builtInEntity,
}

entity Challenge {
  title String required minlength(3) maxlength(100),
  description TextBlob required,
  category AchievementCategory required,
  points Integer required min(1) max(100),
  badge ImageBlob required minbytes(10) maxbytes(1000000),
  createdDate Instant required,
  expiryDate Instant,
  isCompleted Boolean required,
  completedDate Instant,
  isDisplayed Boolean,
}

enum AchievementCategory {
  STUDY,
  SPORTS,
  SOCIAL
}

relationship ManyToOne {
	Challenge{challenges} to Profile
}

relationship ManyToOne {
	Challenge{challengedFriend} to FriendsList
}

relationship ManyToOne {
	Challenge{challengedActivity} to Activity
}

relationship ManyToOne {
	Challenge{creator} to User with builtInEntity
	Challenge{recipient} to User with builtInEntity
}
