entity Profile {
  login String required unique,
  firstName String required,
  lastName String required,
  Bio TextBlob, //max bio length set to 50 characters
  profilePicture ImageBlob,
  course Course required,
  courseYear Long required min(1) max(6), //Course year range 1-6
  university University,
  gymSkill Skill,
  gymLocation GymLocation,
  gymTime PreferredTime,
  studyTime PreferredTime,
  sports Sports,
  sportsSkill Skill,
  sportsTime PreferredTime,
  preferredSociety Society,
  preferredEvents PreferredEvents,
  eventsTime PreferredTime,
  preferredActivities ActivityType,
}

relationship OneToOne {
  Profile{user} to User with builtInEntity
}

enum PreferredEvents{
  GAMES_NIGHT,
  MEET_AND_GREET,
  SPORTS_NIGHT,
  CLUBBING,
  RELIGIOUS,
  ACADEMIC
}

