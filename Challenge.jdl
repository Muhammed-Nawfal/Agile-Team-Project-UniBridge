entity Challenge {
  title String required minlength(3) maxlength(100),
  description TextBlob required,
  category AchievementCategory required,
  points Integer required min(1) max(100),
  badge ImageBlob required minbytes(10) maxbytes(1000000),
  createdDate Instant required,
  expiryDate Instant,
  isCompleted Boolean required,
  completedDate Instant,
  isDisplayed Boolean,
}

enum AchievementCategory {
  STUDY,
  SPORTS,
  SOCIAL
}

relationship ManyToOne {
  Challenge{creator} to User with builtInEntity
  Challenge{recipient} to User with builtInEntity
}
